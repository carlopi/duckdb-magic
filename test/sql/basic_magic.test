# name: test/sql/basic_magic.test
# description: test magic extension
# group: [magic]

require magic

statement ok
ATTACH 'duckdb_file.db'

query I
SELECT magic_type('duckdb_file.db');
----
DuckDB database file, version 64

query I
SELECT magic_mime('duckdb_file.db');
----
application/octet-stream

# Function metadata: description and examples
query T
SELECT description FROM duckdb_functions() WHERE function_name = 'magic_type';
----
Returns the file type description for the given file path using the libmagic database (e.g. 'Apache Parquet', 'JSON data').

query I
SELECT len(examples) FROM duckdb_functions() WHERE function_name = 'magic_type';
----
2

query T
SELECT description FROM duckdb_functions() WHERE function_name = 'magic_mime';
----
Returns the MIME type for the given file path using the libmagic database (e.g. 'application/json', 'text/plain').

query I
SELECT len(examples) FROM duckdb_functions() WHERE function_name = 'magic_mime';
----
2

query T
SELECT description FROM duckdb_functions() WHERE function_name = 'read_any';
----
Auto-detects and reads a file in any supported format. The optional 'format' parameter overrides auto-detection; supported values are: auto (default), json, csv, parquet, avro, vortex, excel, blob, spatial (or geo).

query I
SELECT len(examples) FROM duckdb_functions() WHERE function_name = 'read_any';
----
4
