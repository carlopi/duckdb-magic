# name: test/sql/read_any_tsv.test
# description: test read_any with TSV files (routed to csv_case via text/plain mime)
# group: [sql]

require magic

statement ok
COPY (SELECT 42 AS answer, 'hello' AS word FROM range(5)) TO '__TEST_DIR__/test.tsv' (FORMAT CSV, DELIMITER E'\t', HEADER true)

# magic returns text/plain for TSV — same as CSV, routed via csv_case
query I
SELECT magic_mime('__TEST_DIR__/test.tsv');
----
text/plain

query I
SELECT COUNT(*) FROM read_any('__TEST_DIR__/test.tsv');
----
5

# explicit format:='csv' also works
query I
SELECT COUNT(*) FROM read_any('__TEST_DIR__/test.tsv', format:='csv');
----
5
