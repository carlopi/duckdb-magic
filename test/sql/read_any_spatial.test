# name: test/sql/read_any_spatial.test
# description: test read_any with spatial file formats
# group: [sql]

require magic

statement ok
INSTALL spatial

statement ok
LOAD spatial

# --- GeoPackage (.gpkg) — auto-detected via magic_mime 'application/geopackage+sqlite3' ---

query I
SELECT magic_mime('${DATA_DIR}/test-files/test.gpkg') ILIKE '%geopackage%';
----
true

query I
SELECT COUNT(*) FROM read_any('${DATA_DIR}/test-files/test.gpkg');
----
2

query I
SELECT COUNT(*) FROM read_any('${DATA_DIR}/test-files/test.gpkg', format:='gpkg');
----
2

query I
SELECT COUNT(*) FROM read_any('${DATA_DIR}/test-files/test.gpkg', format:='spatial');
----
2

# --- GeoJSONL / newline-delimited GeoJSON (.geojsonl) — auto-detected by extension ---

query I
SELECT COUNT(*) FROM read_any('${DATA_DIR}/test-files/test.geojsonl');
----
2

query I
SELECT COUNT(*) FROM read_any('${DATA_DIR}/test-files/test.geojsonl', format:='geojsonl');
----
2

# --- TopoJSON (.topojson) — auto-detected by extension ---

query I
SELECT COUNT(*) FROM read_any('${DATA_DIR}/test-files/test.topojson');
----
1

# --- KML (.kml) — auto-detected by extension ---

query I
SELECT COUNT(*) FROM read_any('${DATA_DIR}/test-files/test.kml');
----
1

# FlatGeobuf (.fgb) — auto-detected via magic_type 'FlatGeobuf file'
query I
SELECT COUNT(*) FROM read_any('${DATA_DIR}/test-files/test.fgb');
----
3

# Shapefile (.shp) — auto-detected by extension
query I
SELECT COUNT(*) FROM read_any('${DATA_DIR}/test-files/test.shp');
----
3
