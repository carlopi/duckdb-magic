# name: test/sql/read_any_lance.test
# description: read_any with Lance datasets (a directory, detected by .lance suffix)
# group: [sql]

require magic

require lance

# create a local Lance dataset (a directory)
statement ok
COPY (SELECT i, i*2 AS double_i FROM generate_series(1, 5) t(i)) TO '__TEST_DIR__/test.lance' (FORMAT LANCE)

# .lance suffix: auto-detected (before any magic_* call, since it's a directory)
query I
SELECT COUNT(*) FROM read_any('__TEST_DIR__/test.lance');
----
5

# verify data roundtrips correctly
query II
SELECT i, double_i FROM read_any('__TEST_DIR__/test.lance') ORDER BY i;
----
1	2
2	4
3	6
4	8
5	10

# explicit format parameter
query I
SELECT COUNT(*) FROM read_any('__TEST_DIR__/test.lance', format:='lance');
----
5

# lance is a core extension -> reported without an @community tag
query I
SELECT magic_required_extensions('some/path/data.lance');
----
[lance]
