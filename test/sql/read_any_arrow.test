# name: test/sql/read_any_arrow.test
# description: test read_any with Arrow IPC file format (via nanoarrow)
# group: [sql]

require magic

statement ok
INSTALL nanoarrow FROM community

statement ok
LOAD nanoarrow

# create a local Arrow IPC file
statement ok
COPY (SELECT i, i*2 AS double_i FROM generate_series(1, 5) t(i)) TO '__TEST_DIR__/test.arrow' (FORMAT ARROW)

# .arrow extension: auto-detected by file name pattern
query I
SELECT COUNT(*) FROM read_any('__TEST_DIR__/test.arrow');
----
5

# verify data roundtrips correctly
query II
SELECT i, double_i FROM read_any('__TEST_DIR__/test.arrow') ORDER BY i;
----
1	2
2	4
3	6
4	8
5	10

# explicit format override also works
query I
SELECT COUNT(*) FROM read_any('__TEST_DIR__/test.arrow', format:='arrow');
----
5

# magic_required_extensions reports nanoarrow for .arrow files
query I
SELECT magic_required_extensions('some/path/data.arrow');
----
[nanoarrow]
