# name: test/sql/read_any_yaml.test
# description: test read_any with YAML file format
# group: [sql]

require magic

statement ok
INSTALL yaml FROM community

statement ok
LOAD yaml

# create a local yaml file
statement ok
COPY (SELECT 'test' AS name, 42 AS value FROM range(3)) TO '__TEST_DIR__/test.yaml' WITH (FORMAT yaml)

# auto-detected via .yaml extension
query I
SELECT COUNT(*) FROM read_any('__TEST_DIR__/test.yaml');
----
3

# explicit format:='yaml' also works
query I
SELECT COUNT(*) FROM read_any('__TEST_DIR__/test.yaml', format:='yaml');
----
3

# explicit format:='yml' alias also works
query I
SELECT COUNT(*) FROM read_any('__TEST_DIR__/test.yaml', format:='yml');
----
3

# magic_required_extensions detects yaml by extension
query I
SELECT magic_required_extensions('__TEST_DIR__/test.yaml');
----
[yaml]
